# Copia este archivo a scripts/.env (gitignored) y completa los 5 valores
# reales. NUNCA subas scripts/.env a GitHub — SUPABASE_SERVICE_ROLE_KEY es
# secreta y bypassa Row Level Security.

# Dashboard de Supabase > Project Settings > API
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=TU-SERVICE-ROLE-KEY

# Rutas locales en TU computador a los archivos actuales de la app
CRONO_XLSX_PATH=/ruta/a/2025_Directorio_Auditados_v1.xlsx
HALLAZGOS_XLSX_PATH=/ruta/a/Base de datos QA.xlsx
EVIDENCE_FOLDER_PATH=/ruta/a/V2026
