# Copia este archivo a scripts/.env (gitignored) y completa los valores
# reales que necesite el script que vayas a correr. NUNCA subas scripts/.env
# a GitHub — SUPABASE_SERVICE_ROLE_KEY es secreta y bypassa Row Level
# Security.

# Dashboard de Supabase > Project Settings > API — usado por todos los scripts.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=TU-SERVICE-ROLE-KEY

# --- scripts/migrate-2026.mjs y scripts/generate-comparison-report.mjs ---
# (fuente vigente: un único Excel con las hojas AUDITORIAS_2026 y HALLAZGOS_2026)
EXCEL_2026_PATH=/ruta/a/CONTROL_CRONOGRAMA_HALLAZGOS_AUDITORIAS_2026.xlsx

# --- scripts/migrate-to-supabase.mjs (histórico, fuente anterior a 2026) ---
# CRONO_XLSX_PATH=/ruta/a/2025_Directorio_Auditados_v1.xlsx
# HALLAZGOS_XLSX_PATH=/ruta/a/Base de datos QA.xlsx
# EVIDENCE_FOLDER_PATH=/ruta/a/V2026
